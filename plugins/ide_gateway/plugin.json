{
  "id": "ide_gateway",
  "display_name": "IDE Gateway",
  "version": "0.3.0",
  "entrypoint": "plugin.py",
  "supported_modes": [
    "read_only",
    "full_access"
  ],
  "capabilities": [
    "ide",
    "gateway",
    "openai_compatible",
    "active_bridge",
    "files",
    "media",
    "tools"
  ],
  "config_schema_version": 1,
  "required_env": [],
  "dependencies": [],
  "required": false,
  "install_scope_support": "both",
  "tools": [
    {
      "name": "ide_gateway_start",
      "title": "Start IDE Gateway endpoint",
      "description": "Start a local full OpenAI-compatible API gateway endpoint for the active MCP model to serve IDE requests. Exposes /v1/chat/completions (stream + non-stream), /v1/responses, /v1/models, /v1/files, /v1/images/generations, /v1/images/edits, /v1/audio/speech, /v1/audio/transcriptions, /v1/audio/translations, /v1/embeddings, /v1/moderations, /v1/tools.",
      "capability": "ide_gateway.start",
      "mode_required": "full_access",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "model_id": {
            "type": "string"
          },
          "request_timeout_seconds": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.start",
      "safety_tags": [
        "ide",
        "gateway",
        "network",
        "full_access"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "ide_gateway_stop",
      "title": "Stop IDE Gateway endpoint",
      "description": "Stop a running local IDE Gateway endpoint.",
      "capability": "ide_gateway.stop",
      "mode_required": "full_access",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "force": {
            "type": "boolean"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.stop",
      "safety_tags": [
        "ide",
        "gateway",
        "network",
        "full_access"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "ide_gateway_status",
      "title": "IDE Gateway status",
      "description": "Show running status and queue status for IDE Gateway endpoints.",
      "capability": "ide_gateway.status",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.status",
      "safety_tags": [
        "ide",
        "gateway",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "ide_gateway_show_config",
      "title": "Show IDE Gateway connection config",
      "description": "Return copy-paste-ready OpenAI-compatible provider settings for an IDE.",
      "capability": "ide_gateway.show_config",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "include_secret": {
            "type": "boolean"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.show_config",
      "safety_tags": [
        "ide",
        "gateway",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "ide_gateway_get_logs",
      "title": "Read IDE Gateway logs",
      "description": "Read recent redacted logs for a local IDE Gateway endpoint.",
      "capability": "ide_gateway.logs",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.get_logs",
      "safety_tags": [
        "ide",
        "gateway",
        "logs",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "ide_gateway_rotate_token",
      "title": "Rotate IDE Gateway token",
      "description": "Generate a new local API token for an IDE Gateway endpoint.",
      "capability": "ide_gateway.rotate_token",
      "mode_required": "full_access",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.rotate_token",
      "safety_tags": [
        "ide",
        "gateway",
        "secret",
        "full_access"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "ide_gateway_bridge_prompt",
      "title": "Show IDE Gateway sandbox bootstrap prompt",
      "description": "Return a copy-paste prompt snippet that tells the model how to bootstrap the sandbox server and keyless Tunnellio TCP bridge with one command.",
      "capability": "ide_gateway.bridge_prompt",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "include_secret": {
            "type": "boolean"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "ide_gateway.bridge_prompt",
      "safety_tags": [
        "ide",
        "gateway",
        "bridge",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    }
  ]
}