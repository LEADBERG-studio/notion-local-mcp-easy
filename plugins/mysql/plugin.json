{
  "id": "mysql",
  "display_name": "MySQL / MariaDB",
  "version": "1.0.0",
  "entrypoint": "plugin.py",
  "supported_modes": ["read_only", "full_access"],
  "capabilities": ["database", "sql", "query", "mysql", "mariadb"],
  "config_schema_version": 1,
  "required_env": [],
  "dependencies": ["mysql"],
  "required": false,
  "install_scope_support": "both",
  "tools": [
    {
      "name": "mysql_list_connections",
      "title": "MySQL list connections",
      "description": "List configured MySQL connection aliases for the active profile context.",
      "capability": "database.list_connections",
      "mode_required": "read_only",
      "input_schema": {"type": "object", "properties": {}},
      "output_schema": {"type": "object"},
      "handler_ref": "mysql.list_connections",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "mysql_list_tables",
      "title": "MySQL list tables",
      "description": "List tables, types and approximate row counts for a configured MySQL connection alias.",
      "capability": "database.list_tables",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "row_limit": {"type": "integer", "description": "Maximum rows to return. Defaults to a transport-safe cap."}
        },
        "required": ["connection"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "mysql.list_tables",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "mysql_describe_table",
      "title": "MySQL describe table",
      "description": "Describe columns, keys and defaults of a table in a configured MySQL connection alias.",
      "capability": "database.describe_table",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "table": {"type": "string", "description": "Table name, optionally schema-qualified."}
        },
        "required": ["connection", "table"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "mysql.describe_table",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "mysql_query",
      "title": "MySQL query",
      "description": "Run a single read-only SQL query. Rows are capped for transport safety; use row_limit or LIMIT/OFFSET to page.",
      "capability": "database.query",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "sql": {"type": "string"},
          "row_limit": {"type": "integer"},
          "params_json": {"type": "string"}
        },
        "required": ["connection", "sql"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "mysql.query",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "mysql_execute",
      "title": "MySQL execute",
      "description": "Run a mutating SQL statement against a configured MySQL connection alias. Requires full_access.",
      "capability": "database.execute",
      "mode_required": "full_access",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "sql": {"type": "string"},
          "params_json": {"type": "string"}
        },
        "required": ["connection", "sql"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "mysql.execute",
      "safety_tags": ["db", "full_access"],
      "diagnostic_visibility": "full"
    }
  ]
}
