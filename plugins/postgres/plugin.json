{
  "id": "postgres",
  "display_name": "PostgreSQL",
  "version": "1.0.0",
  "entrypoint": "plugin.py",
  "supported_modes": ["read_only", "full_access"],
  "capabilities": ["database", "sql", "query", "postgresql"],
  "config_schema_version": 1,
  "required_env": [],
  "dependencies": ["psql"],
  "required": false,
  "install_scope_support": "both",
  "tools": [
    {
      "name": "postgres_list_connections",
      "title": "PostgreSQL list connections",
      "description": "List configured PostgreSQL connection aliases for the active profile context.",
      "capability": "database.list_connections",
      "mode_required": "read_only",
      "input_schema": {"type": "object", "properties": {}},
      "output_schema": {"type": "object"},
      "handler_ref": "postgres.list_connections",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_list_tables",
      "title": "PostgreSQL list tables",
      "description": "List tables for a configured PostgreSQL connection alias.",
      "capability": "database.list_tables",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"}
        },
        "required": ["connection"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "postgres.list_tables",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_describe_table",
      "title": "PostgreSQL describe table",
      "description": "Describe columns of a table in a configured PostgreSQL connection alias.",
      "capability": "database.describe_table",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "table": {"type": "string"}
        },
        "required": ["connection", "table"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "postgres.describe_table",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_query",
      "title": "PostgreSQL query",
      "description": "Run a read-only SQL query against a configured PostgreSQL connection alias.",
      "capability": "database.query",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "sql": {"type": "string"},
          "params_json": {"type": "string"}
        },
        "required": ["connection", "sql"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "postgres.query",
      "safety_tags": ["db", "read_only"],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_execute",
      "title": "PostgreSQL execute",
      "description": "Run a mutating SQL statement against a configured PostgreSQL connection alias.",
      "capability": "database.execute",
      "mode_required": "full_access",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {"type": "string"},
          "sql": {"type": "string"},
          "params_json": {"type": "string"}
        },
        "required": ["connection", "sql"]
      },
      "output_schema": {"type": "object"},
      "handler_ref": "postgres.execute",
      "safety_tags": ["db", "full_access"],
      "diagnostic_visibility": "full"
    }
  ]
}
