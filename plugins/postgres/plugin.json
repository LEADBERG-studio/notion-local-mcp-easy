{
  "id": "postgres",
  "display_name": "PostgreSQL",
  "version": "2.0.0",
  "entrypoint": "plugin.py",
  "supported_modes": [
    "read_only",
    "full_access"
  ],
  "capabilities": [
    "database",
    "sql",
    "query",
    "postgresql"
  ],
  "config_schema_version": 1,
  "required_env": [],
  "dependencies": [
    "psql"
  ],
  "required": false,
  "install_scope_support": "both",
  "tools": [
    {
      "name": "postgres_list_connections",
      "title": "PostgreSQL list connections",
      "description": "List configured connection aliases with their database and host.",
      "capability": "database.list_connections",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.list_connections",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_server_info",
      "title": "PostgreSQL server info",
      "description": "Report the server version and confirm it meets the PostgreSQL version this plugin targets. Use this first when a connection misbehaves.",
      "capability": "database.server_info",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          }
        },
        "required": [
          "connection"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.server_info",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_list_schemas",
      "title": "PostgreSQL list schemas",
      "description": "List non-system schemas visible to this connection.",
      "capability": "database.list_schemas",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "row_limit": {
            "type": "integer",
            "description": "Maximum rows to return. Capped for transport safety."
          }
        },
        "required": [
          "connection"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.list_schemas",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_list_tables",
      "title": "PostgreSQL list tables",
      "description": "List tables with type and on-disk size.",
      "capability": "database.list_tables",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "schema": {
            "type": "string",
            "description": "Schema to inspect. Defaults to all non-system schemas."
          },
          "row_limit": {
            "type": "integer",
            "description": "Maximum rows to return. Capped for transport safety."
          }
        },
        "required": [
          "connection"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.list_tables",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_describe_table",
      "title": "PostgreSQL describe table",
      "description": "Describe columns, indexes and constraints of one table.",
      "capability": "database.describe_table",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "table": {
            "type": "string",
            "description": "Table name, optionally schema-qualified."
          }
        },
        "required": [
          "connection",
          "table"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.describe_table",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_count_rows",
      "title": "PostgreSQL count rows",
      "description": "Exact row count for a table, with an optional WHERE clause.",
      "capability": "database.count_rows",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "table": {
            "type": "string",
            "description": "Table name, optionally schema-qualified."
          },
          "where": {
            "type": "string",
            "description": "Optional WHERE clause without the WHERE keyword."
          }
        },
        "required": [
          "connection",
          "table"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.count_rows",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_sample_rows",
      "title": "PostgreSQL sample rows",
      "description": "Return the first rows of a table so its shape is obvious without writing SQL.",
      "capability": "database.sample_rows",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "table": {
            "type": "string",
            "description": "Table name, optionally schema-qualified."
          },
          "row_limit": {
            "type": "integer",
            "description": "Maximum rows to return. Capped for transport safety."
          }
        },
        "required": [
          "connection",
          "table"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.sample_rows",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_query",
      "title": "PostgreSQL query",
      "description": "Run a read-only SQL query. The connection is read-only at the server level, so writes are refused. Rows are capped; page with LIMIT/OFFSET or row_limit.",
      "capability": "database.query",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "sql": {
            "type": "string"
          },
          "row_limit": {
            "type": "integer",
            "description": "Maximum rows to return. Capped for transport safety."
          },
          "params_json": {
            "type": "string"
          }
        },
        "required": [
          "connection",
          "sql"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.query",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_explain",
      "title": "PostgreSQL explain",
      "description": "Show the query plan without running the query.",
      "capability": "database.explain",
      "mode_required": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "sql": {
            "type": "string"
          },
          "analyze": {
            "type": "string",
            "description": "Set to 'true' to run EXPLAIN ANALYZE. Requires full_access because it executes the query."
          }
        },
        "required": [
          "connection",
          "sql"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.explain",
      "safety_tags": [
        "db",
        "read_only"
      ],
      "diagnostic_visibility": "full"
    },
    {
      "name": "postgres_execute",
      "title": "PostgreSQL execute",
      "description": "Run a mutating SQL statement. Requires full_access.",
      "capability": "database.execute",
      "mode_required": "full_access",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "description": "Configured connection alias."
          },
          "sql": {
            "type": "string"
          },
          "params_json": {
            "type": "string"
          }
        },
        "required": [
          "connection",
          "sql"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "handler_ref": "postgres.execute",
      "safety_tags": [
        "db",
        "full_access"
      ],
      "diagnostic_visibility": "full"
    }
  ]
}
